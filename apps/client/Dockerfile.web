# ============================================
# Web app — Expo web export
# ============================================
# Build with: docker build -f apps/client/Dockerfile.web -t ffd-connect-webapp .
# Context: monorepo root (for pnpm workspaces)

# ── Stage 1: Build ───────────────────────────
FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@10.30.0 --activate

WORKDIR /app

# Copy workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/client/package.json ./apps/client/
# packages/shared has a `prepare: tsc` script that runs during install — needs source
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/jest-config/package.json ./packages/jest-config/
COPY patches ./patches

RUN YOUTUBE_DL_SKIP_PYTHON_CHECK=1 pnpm install --filter client... --no-frozen-lockfile

# Copy source
COPY apps/client ./apps/client
COPY packages ./packages

# Build for web (output in dist/)
ARG EXPO_PUBLIC_API_URL=https://api.ffd.gabin-simond.fr
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
ENV NODE_ENV=production

WORKDIR /app/apps/client
RUN pnpm exec expo export --platform web --output-dir dist

# ── Stage 2: Serve ───────────────────────────
FROM nginx:alpine

COPY --from=build /app/apps/client/dist /usr/share/nginx/html

# SPA fallback: route everything to index.html
RUN echo 'server { \
  listen 80; \
  server_name _; \
  root /usr/share/nginx/html; \
  index index.html; \
  location / { try_files $uri $uri/ /index.html; } \
  location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf)$ { \
    expires 1y; \
    add_header Cache-Control "public, immutable"; \
  } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O- http://localhost/ > /dev/null || exit 1
