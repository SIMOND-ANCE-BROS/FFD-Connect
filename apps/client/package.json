    "babel-preset-expo": "~57.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "expo-build-properties": "~57.0.3",
    "jest-expo": "~57.0.1",
    "msw": "^3.0.2",
    "react-native-dotenv": "^3.4.11",
    "serve": "^14.2.6",
    "test-renderer": "^1.3.0",
    "typescript-eslint": "^8.71.0",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22"
  },
  "expo": {
