{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "main": "index",
  "browser": "index.web.js",
  "scripts": {
    "postinstall": "if [ -f openapi-ts.config.ts ] && [ -f ../backend/swagger.json ]; then openapi-ts; else echo '[api-client] skipped: inputs absent from this install context'; fi",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start": "expo start --host lan",
    "start:dev": "expo start --dev-client",
    "lint": "eslint .",
    "test": "jest --silent",
    "test:debug": "jest --verbose",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "maestro test .maestro",
    "test:e2e:smoke": "maestro test .maestro/login.yaml .maestro/competitions_list.yaml .maestro/scanner_checkin.yaml",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:dev": "pnpm dlx eas-cli build --profile development --non-interactive",
    "build:beta": "pnpm dlx eas-cli build --profile preview --non-interactive",
    "build:beta:ios": "pnpm dlx eas-cli build --profile preview --platform ios --non-interactive",
    "build:prod": "pnpm dlx eas-cli build --profile production --non-interactive",
    "typecheck": "tsc --noEmit",
    "test:e2e:web": "playwright test",
    "test:e2e:web:ui": "playwright test --ui"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/dom-webview": "~57.0.0",
    "@expo/metro-runtime": "~57.0.3",
    "@ffd-connect/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-firebase/app": "24.1.1",
    "@react-native-firebase/messaging": "24.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "axios": "^1.20.0",
    "expo": "~57.0.4",
    "expo-application": "~57.0.0",
    "expo-audio": "~57.0.0",
    "expo-blur": "~57.0.0",
