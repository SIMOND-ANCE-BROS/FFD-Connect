# Paths are relative to the monorepo root (EAS archives from root for pnpm workspaces)

# Other apps - not needed for client build.
# apps/backend uses `/*` rather than `/` on purpose: gitignore semantics cannot
# re-include a file under an excluded DIRECTORY, so the negation below would be
# silently ignored. Verified with git check-ignore, both ways.
apps/backend/*
# ...except the OpenAPI spec. apps/client/src/api/generated/ is gitignored and
# produced from it by the postinstall; without it here the guard skips, the
# directory never exists on EAS, and Metro dies on "Unable to resolve module
# ../../../api/generated". Before #51 the generated files were committed and
# travelled in this archive — they no longer do.
!apps/backend/swagger.json
apps/landing/
apps/docs/

# Native folders - EAS rebuilds them
apps/client/ios/
apps/client/android/

# Large assets
apps/backend/uploads/

# Cache and artifacts
**/.expo/
**/.expo-shared/
**/node_modules/
**/coverage/
**/.jest-cache/
**/*.log

# Dev/CI files
docs/
scripts/
.github/
.husky/
.changeset/

# Misc
.DS_Store
**/.DS_Store
*.sql
backups/
.env
.env.*
!.env.example
**/__tests__/**/*.mp3
**/__tests__/**/*.png
**/__mocks__/**/*.mp3
