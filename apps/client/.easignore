# Paths are relative to the monorepo root (EAS archives from root for pnpm workspaces)

# Other apps - not needed for client build
apps/backend/
apps/landing/
apps/docs/

# Native folders - EAS rebuilds them
apps/client/ios/
apps/client/android/

# Large assets
apps/backend/uploads/

# Cache and artifacts
**/.expo/
**/.expo-shared/
**/node_modules/
**/coverage/
**/.jest-cache/
**/*.log

# Dev/CI files
docs/
scripts/
.github/
.husky/
.changeset/

# Misc
.DS_Store
**/.DS_Store
*.sql
backups/
.env
.env.*
!.env.example
**/__tests__/**/*.mp3
**/__tests__/**/*.png
**/__mocks__/**/*.mp3
