# ============================================
# FFD CONNECT - Configuration Backend
# ============================================
# Ce fichier liste toutes les variables d'environnement disponibles.
# Copiez ce fichier vers .env et remplissez les valeurs selon votre environnement.
#
# Guide de configuration:
# 1. Copiez ce fichier: cp .env.example .env
# 2. Remplissez les variables REQUISES
# 3. Configurez les variables OPTIONNELLES selon vos besoins
# 4. En production, utilisez des secrets sécurisés
# ============================================

# ============================================
# VARIABLES REQUISES
# ============================================

# Database PostgreSQL
# Format: postgresql://user:password@host:port/database
# Exemple local: postgresql://postgres:password@localhost:5432/ffd_connect
# Exemple production: postgresql://user:pass@db.example.com:5432/ffd_connect_prod
DATABASE_URL="postgresql://user:password@localhost:5432/ffd_connect"

# Secret JWT pour l'authentification
# ⚠️ CRITIQUE: Utilisez une clé sécurisée d'au moins 32 caractères en production
# Générez une clé sécurisée avec: openssl rand -base64 32
# Ne partagez JAMAIS cette clé et ne la commitez pas dans le dépôt Git
# En production, utilisez un gestionnaire de secrets (AWS Secrets Manager, HashiCorp Vault, etc.)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"

# ============================================
# CONFIGURATION DU SERVEUR
# ============================================

# Port sur lequel le serveur écoute
# Par défaut: 3000
# En production, utilisez généralement 80 (HTTP) ou 443 (HTTPS) avec un reverse proxy
PORT=3000

# Environnement d'exécution
# Valeurs possibles: development, production, test
# En production, définit automatiquement certaines optimisations
NODE_ENV=development

# ============================================
# CONFIGURATION CORS
# ============================================

# Liste des origines autorisées séparées par des virgules
# En développement: http://localhost:3000,http://localhost:19006
# En production: spécifiez uniquement vos domaines autorisés (ex: https://app.ffdconnect.fr)
# ⚠️ Ne laissez pas "*" en production pour des raisons de sécurité
CORS_ORIGINS=http://localhost:3000,https://app.ffdconnect.fr

# ============================================
# CONFIGURATION API FFD (Fédération Française de Danse)
# ============================================

# URL de base de l'API FFD
# URL officielle de l'API FFD pour récupérer les compétitions
FFD_API_BASE_URL="https://api.ffdanse.fr"

# Chemin de l'endpoint API FFD
# Chemin relatif pour accéder aux actions fédérales
FFD_API_PATH="/federal_actions"

# Nombre d'éléments par page lors de la récupération des données FFD
# Augmentez cette valeur si vous avez besoin de récupérer plus de compétitions par requête
FFD_ITEMS_PER_PAGE=50

# Familles de danses à récupérer
# Valeurs possibles: "latines-standards" (toutes), "latines", "standards"
FFD_DANCE_FAMILIES="latines-standards"

# Catégorie d'événements à récupérer
# Filtre les événements par catégorie (ex: "Compétitions", "Stages", etc.)
FFD_EVENT_CATEGORY="Compétitions"

# ============================================
# REDIS (Optionnel - Cache et Sessions)
# ============================================
# Redis est utilisé pour le cache et la gestion des sessions
# Si non configuré, l'application fonctionnera sans cache

# Adresse du serveur Redis
# Par défaut: localhost
REDIS_HOST=localhost

# Port du serveur Redis
# Port par défaut: 6379
REDIS_PORT=6379

# Mot de passe Redis (optionnel)
# Si votre instance Redis nécessite une authentification
# REDIS_PASSWORD="your-redis-password"

# Base de données Redis à utiliser (0-15)
# Par défaut: 0
# REDIS_DB=0

# ============================================
# FIREBASE (Optionnel - Notifications Push)
# ============================================
# Nécessaire uniquement si vous utilisez les notifications push
# Pour obtenir ces informations:
# 1. Créez un projet Firebase
# 2. Activez Cloud Messaging
# 3. Générez une clé de compte de service
# 4. Récupérez les informations depuis la console Firebase

# ID du projet Firebase
FIREBASE_PROJECT_ID="your-project-id"

# Clé privée du compte de service Firebase
# Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="your-private-key"

# Email du compte de service Firebase
# Format: firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL="your-client-email"

# Credentials effectivement lus par le backend (NotificationsService), dans cet
# ordre de priorité. Aucun des deux => notifications en mode mock (pas d'envoi).
#
# 1. JSON complet du compte de service, sur une seule ligne. C'est la seule
#    forme utilisable en cloud (Azure Container Apps n'a pas de FS pour une clé) :
#    en prod/staging la valeur vient de Key Vault.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
#
# 2. Repli développement local : chemin vers le fichier de clé téléchargé.
# FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"

# ============================================
# RESEND (Email Service)
# ============================================
# Service d'envoi d'emails transactionnels
# Créez un compte sur https://resend.com et obtenez votre clé API
# Plan gratuit: 3000 emails/mois, puis $20/mois pour 50k emails

# Clé API Resend
# Obtenez votre clé API depuis: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Email de l'expéditeur (doit être vérifié dans Resend)
# Format: noreply@yourdomain.com ou onboarding@resend.dev (pour les tests)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ============================================
# WDSF (Optionnel - Vérification licences athlètes)
# ============================================
# API World Dance Sport Federation - https://github.com/jaykay-design/WDSF-API/wiki
#
# Endpoints (optionnel) : par défaut production. Pour le staging/sandbox :
# WDSF_API_V1_URL="https://sandbox.worlddancesport.org/api/1"
# WDSF_API_V2_URL="https://api.wdsf.org/api/2"
#
# 1) Token API v2 (recommandé) : générer sur https://my.wdsf.org/Account/Manage/Tokens
#    Utilise l'API v2 avec le header X-WDSF-API-KEY.
# WDSF_API_KEY="votre-token-wdsf"
#
# 2) Identifiants API v1 : Basic Auth (obligatoires pour le fallback quand la v2 renvoie 404)
#    Créer un compte "Service Consumer" (lecture seule) : https://sso.wdsf.org/Register/Account/ServiceConsumer
#    Utiliser exactement ce login/mot de passe (401 = identifiants refusés, vérifier pas d'espaces dans .env).
# WDSF_USERNAME="votre-identifiant-service-consumer"
# WDSF_PASSWORD="votre-mot-de-passe-service-consumer"

# ============================================
# GITHUB (Optionnel - Rapports de Bugs)
# ============================================
# Nécessaire uniquement si vous utilisez l'intégration GitHub pour les rapports
# Permet de créer automatiquement des issues GitHub depuis les rapports de bugs

# Token d'accès GitHub avec permissions repo
# Créez un token avec les permissions "repo" sur: https://github.com/settings/tokens
GITHUB_TOKEN="your-github-token"

# Propriétaire du dépôt GitHub (nom d'utilisateur ou organisation)
GITHUB_OWNER="your-username"

# Nom du dépôt GitHub où créer les issues
GITHUB_REPO="ffd-connect-reports"

# ============================================
# SENTRY (Optionnel - Crash Reporting)
# ============================================
# Envoie les erreurs backend à Sentry pour le monitoring.
# Créez un projet NestJS/Node sur https://sentry.io et copiez le DSN.
# Plan gratuit: 5000 erreurs/mois

# DSN Sentry (format: https://xxx@xxx.ingest.sentry.io/xxx)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# ============================================
# AZURE AI VISION (Optionnel - OCR)
# ============================================
# Reconnaissance optique de caractères pour les licences de danse.
# Auth par managed identity en production (aucune clé téléchargée).
# En développement local: utilisez `az login` ou mode mock (endpoint absent).

# Endpoint Azure AI Vision
# Format: https://votre-nom.cognitiveservices.azure.com
# AZURE_VISION_ENDPOINT="https://votre-nom.cognitiveservices.azure.com"

# ============================================
# AZURE AI SPEECH (Optionnel - TTS)
# ============================================
# Synthèse vocale pour les annonces de compétition.
# Auth par managed identity en production (aucune clé téléchargée).
# En développement local: utilisez `az login`.

# Endpoint Azure AI Speech (REQUIS si TTS activé)
# Format: https://votre-nom.cognitiveservices.azure.com
# AZURE_SPEECH_ENDPOINT="https://votre-nom.cognitiveservices.azure.com"

# Voix neurale FR (défaut: fr-FR-DeniseNeural)
# AZURE_SPEECH_VOICE="fr-FR-DeniseNeural"

# ARM resource id du compte Speech (optionnel)
# Utilisé pour l'authentification Entra ID encapsulée.
# Format: /subscriptions/{sub-id}/resourceGroups/{rg}/providers/Microsoft.CognitiveServices/accounts/{name}
# AZURE_SPEECH_RESOURCE_ID="/subscriptions/xxx/resourceGroups/xxx/providers/Microsoft.CognitiveServices/accounts/xxx"

# ============================================
# CONFIGURATION AVANCÉE (Optionnel)
# ============================================

# Timeout pour les requêtes HTTP (en millisecondes)
# Par défaut: 30000 (30 secondes)
# HTTP_TIMEOUT=30000

# Taille maximale du body des requêtes (en bytes)
# Par défaut: 10MB
# MAX_REQUEST_SIZE=10485760

# Durée de vie du token JWT (en secondes)
# Par défaut: 3600 (1 heure)
# JWT_EXPIRES_IN=3600

# Durée de vie du refresh token (en secondes)
# Par défaut: 2592000 (30 jours)
# JWT_REFRESH_EXPIRES_IN=2592000

# ============================================
# SEED LOCAL - Couple de dev (Optionnel)
# ============================================
# Couple de licenciés CVDS créé par scripts/seed.ts et conservé par sync:compete.
# Valeurs par défaut FICTIVES (voir scripts/seed-owner-couple.ts). Surchargez-les
# ici avec vos propres données pour vous connecter avec votre compte en local.
# ⚠️ Ne mettez jamais de données réelles dans ce fichier d'exemple (versionné).
# SEED_OWNER_FIRST_NAME="Lucas"
# SEED_OWNER_LAST_NAME="BERNARD"
# SEED_OWNER_EMAIL="lucas.bernard@example.com"
# SEED_OWNER_BIRTH_DATE="2000-01-01"
# SEED_OWNER_LICENSE="20000101-ber-lu01"
# SEED_PARTNER_FIRST_NAME="Emma"
# SEED_PARTNER_LAST_NAME="MOREAU"
# SEED_PARTNER_EMAIL="emma.moreau@example.com"
# SEED_PARTNER_BIRTH_DATE="2001-01-01"
# SEED_PARTNER_LICENSE="20010101-mor-em01"

# ============================================
# NOTES IMPORTANTES
# ============================================
# 1. Sécurité:
#    - Ne commitez JAMAIS le fichier .env dans Git
#    - Utilisez des secrets forts en production
#    - Changez tous les mots de passe par défaut
#
# 2. Production:
#    - Utilisez un gestionnaire de secrets (AWS Secrets Manager, etc.)
#    - Configurez HTTPS avec un certificat SSL valide
#    - Activez les logs et le monitoring
#    - Configurez des sauvegardes régulières de la base de données
#
# 3. Développement:
#    - Vous pouvez utiliser des valeurs par défaut pour le développement local
#    - Assurez-vous que PostgreSQL et Redis sont démarrés localement
#
# 4. Support:
#    - Consultez la documentation: docs/
#    - Issues GitHub: https://github.com/your-org/ffd-connect/issues
# ============================================
