enum TrackStatus {
  PENDING
  READY
  ERROR
}

model Track {
  id            String      @id @default(uuid())
  title         String
  artist        String
  filename      String
  artwork       String?
  style         String?
  /// Tempo in MPM (mesures par minute) — the dance-aware value shown in the UI.
  bpm           Float       @default(0)
  /// Raw detected tempo in BPM (beats per minute) before the dance-specific
  /// MPM conversion. Kept so MPM can be recomputed when the dance changes.
  rawBpm        Float       @default(0)
  status        TrackStatus @default(PENDING)
  /// Paso doble uniquement : timecodes (secondes) des appels/coups (« clashs »)
  /// affichés sur le lecteur. Édités par un admin ; par défaut estimés côté
  /// client depuis le tempo + la structure standard España Cañí.
  clashTimecodes Float[]    @default([])
  /// Modération admin — masque le titre réel côté clients non-admin
  /// (remplacé par un libellé neutre). Les admins voient toujours le vrai titre.
  titleMasked   Boolean     @default(false)
  /// Modération admin — retire la piste de la bibliothèque partagée
  /// (exclue de LIBRARY_WHERE, invisible pour tous).
  blacklisted   Boolean     @default(false)
  jobId         String?
  /// Normalized provider+id key (e.g. "youtube:dQw4w9WgXcQ") used to dedup
  /// repeated submissions of the same source. Null for legacy/manual entries.
  sourceKey     String?     @unique
  /// SHA-256 (hex) of the audio file imported from the back-office, to refuse
  /// a second import of the same file. Null for tracks added before lot 3.
  contentHash   String?     @unique
  submittedById String?
  submittedBy   User?       @relation("TrackSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)
  /// Propositions de correction des métadonnées soumises par les utilisateurs.
  corrections   TrackCorrection[]
  createdAt     DateTime    @default(now())

  @@index([submittedById])
  @@index([sourceKey, status])
}

/// Motif d'une proposition de correction : la métadonnée que l'utilisateur
/// estime incorrecte. Mêmes valeurs que `ReportTrackReason` (DTO historique
/// de POST /tracks/:id/report), pour que les anciens signalements atterrissent
/// dans la même file de modération.
enum TrackCorrectionReason {
  TITLE
  ARTIST
  DANCE
  MPM
  PASO_CLASH
  OTHER
}

/// Cycle de vie d'une proposition de correction : en attente de décision d'un
/// administrateur, puis validée (appliquée à la piste) ou refusée. Une décision
/// est définitive.
enum TrackCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Proposition de correction des métadonnées d'une piste, soumise par un
/// utilisateur et arbitrée par un administrateur.
///
/// Les valeurs proposées sont nullables : null = « pas de proposition sur ce
/// champ ». Seules les valeurs qui diffèrent réellement de la piste au moment
/// de la proposition sont stockées. Les timecodes de clash utilisent un drapeau
/// séparé (`proposesClashes`) parce qu'une liste vide est une proposition
/// légitime (« aucun clash »), indiscernable sinon de l'absence de proposition.
///
/// RGPD : `proposedById` passe à null à la suppression du compte, et le
/// commentaire libre (`message`, potentiellement identifiant) est effacé par
/// UsersService.deleteMyAccount. Les propositions figurent dans l'export
/// (UsersService.exportMyData).
model TrackCorrection {
  id                     String                @id @default(uuid())
  trackId                String
  track                  Track                 @relation(fields: [trackId], references: [id], onDelete: Cascade)
  /// Auteur de la proposition. Null après suppression de son compte.
  proposedById           String?
  proposedBy             User?                 @relation("TrackCorrectionsProposed", fields: [proposedById], references: [id], onDelete: SetNull)
  reason                 TrackCorrectionReason
  proposedTitle          String?
  proposedArtist         String?
  /// Danse proposée (texte libre, même format que Track.style).
  proposedStyle          String?
  /// Tempo proposé en MPM.
  proposedBpm            Float?
  /// Vrai si la proposition porte sur les timecodes de clash paso doble
  /// (y compris une liste vide = « aucun clash »).
  proposesClashes        Boolean               @default(false)
  /// Timecodes (secondes) proposés, triés et dédupliqués.
  proposedClashTimecodes Float[]               @default([])
  /// Commentaire libre de l'auteur de la proposition.
  message                String?
  status                 TrackCorrectionStatus @default(PENDING)
  /// Administrateur ayant tranché. Null tant que PENDING ou après suppression
  /// de son compte.
  reviewedById           String?
  reviewedBy             User?                 @relation("TrackCorrectionsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Commentaire de l'administrateur, renvoyé à l'auteur avec la décision.
  reviewComment          String?
  reviewedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  // File de modération : GET /track-corrections?status=PENDING trié par date.
  @@index([status, createdAt])
  @@index([trackId])
  // « Mes propositions » + purge RGPD à la suppression du compte.
  @@index([proposedById])
}
