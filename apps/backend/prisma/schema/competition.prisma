/// Type de compétition (Article 8) : proximité, nationale, majeure, internationale.
enum CompetitionType {
  PROXIMITE      // Compétitions de proximité (aire géographique)
  NATIONALE      // Compétitions nationales
  MAJEURE        // Majeures (championnat régional, coupe de France, championnat de France)
  INTERNATIONALE // WDSF, plusieurs pays
}

/// Nature de l'épreuve pour les règles de participation (Article 9).
enum EventKind {
  CLASSIFICATRICE // Épreuve classificatrice (classe d'âge + niveau imposés)
  OPEN           // Open (regroupe classes/niveaux)
  MAJEURE        // Épreuve majeure (tous niveaux, une épreuve par spécialité)
  SOLO_TEAM      // Solo Danse Team
  SHOW_DANSE     // Show danse
}

/// Type d'épreuve : SOLO = inscription seule ; COUPLE = inscription avec partenaire obligatoire.
enum EventType {
  SOLO
  COUPLE
}

/// TEMPORAIRE (tant que l'app n'est pas reliée à la FFD) : origine des épreuves
/// d'une compétition synchronisée. GENERIC = épreuves génériques par défaut ;
/// DESCRIPTION / CIRCULAR = déduites du texte FFD / de la circulaire PDF (à vérifier).
enum EventsSource {
  GENERIC
  DESCRIPTION
  CIRCULAR
}

enum CompetitionStatus {
  UPCOMING
  LIVE
  PAST
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Competition {
  id              String            @id @default(uuid())
  title           String
  date            DateTime
  location        String
  status          CompetitionStatus  @default(UPCOMING)
  delayMinutes    Int                @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ffdId           String?           @unique
  address         String?
  circularUrl     String?
  city            String?
  description     String?
  imageUrl        String?
  latitude        Float?
  longitude       Float?
  organizer       String?           // Libellé d'affichage du club organisateur (nom FFD)
  organizerClubId String?           // Club organisateur (#408) : clé des résolutions (paiement, droits) ; null = pas encore relié
  organizerClub   Club?             @relation("CompetitionOrganizerClub", fields: [organizerClubId], references: [id], onDelete: SetNull)
  registrationUrl String?
  endDate         DateTime?         // FFD endAt (fin de la compétition)
  eventsDescription String?         // FFD danceEventDescription : programme des épreuves (texte libre)
  programUrl      String?           // FFD fileEvents : PDF du programme des épreuves
  type            String?           // Libellé libre (affichage)
  competitionType CompetitionType?  // Article 8 : PROXIMITE | NATIONALE | MAJEURE | INTERNATIONALE
  majorSubType    String?           // Si MAJEURE : CHAMPIONNAT_REGIONAL | CHAMPIONNAT_FRANCE_LATINES | ...
  zipCode         String?
  events          Event[]
  schedule        ScheduleItem[]
  volunteerTokens VolunteerToken[]
  ticketingUrl           String?
  layout                 Json?            @default("[]")
  registrationDeadline   DateTime?        // Date limite d'inscription (pour countdown)
  eventsSource           EventsSource?    // TEMPORAIRE : origine des épreuves (null = antérieur / saisie manuelle)
  eventsFingerprint      String?          // TEMPORAIRE : empreinte des documents déjà analysés (évite de retraiter)
  // Dernier enregistrement des épreuves / du planning par l'organisateur dans
  // l'éditeur club (#442). Non nul : la synchro FFD ne remplace plus ni ne
  // complète les épreuves (la saisie du club fait foi).
  programEditedAt        DateTime?
  seatBookings           SeatBooking[]

  @@index([date])
  @@index([status])
  @@index([ffdId])
  @@index([city])
  @@index([competitionType])
  @@index([status, date])
  @@index([organizerClubId])
}

model Event {
  id            String         @id @default(uuid())
  competitionId String
  category      String         // Spécialité : Latin, Standard, Ten Dance
  ageGroup      String         // Classe d'âge de l'épreuve
  eventType     EventType      @default(COUPLE) // SOLO | COUPLE
  level         String?        // Niveau épreuve classificatrice : International, Avancé, Intermédiaire, Débutant
  eventKind     EventKind?     // Article 9 : CLASSIFICATRICE | OPEN | MAJEURE | SOLO_TEAM | SHOW_DANSE
  // Open (#442) : classes d'âge réunies (la première est aussi dans `ageGroup`)
  // et restriction par niveaux (vide = tous niveaux). Vides hors Open.
  ageGroups     String[]       @default([])
  openLevels    String[]       @default([])
  position      Int?           // Ordre de saisie dans l'éditeur club (#442)
  competition   Competition    @relation(fields: [competitionId], references: [id])
  registrations Registration[]
  results       Result[]
  scheduleItems ScheduleItem[]

  @@index([competitionId])
  @@index([category])
  @@index([ageGroup])
  @@index([eventType])
  @@index([eventKind])
  @@index([competitionId, eventType]) // épreuves SOLO/COUPLE d'une compétition
}

model Registration {
  id                     String             @id @default(uuid())
  eventId                String
  userId                 String
  partnerName            String?
  partnerUserId          String?            // Partenaire licencié (pour calcul auto classe d'âge couple)
  status                 RegistrationStatus  @default(PENDING)
  bibNumber              Int?
  checkedIn              Boolean             @default(false)
  checkInTime            DateTime?
  feePaid                Boolean             @default(false)
  createdAt              DateTime            @default(now())
  // Profil couple/solo : classe d'âge (calculée si birthDate(s) connus, sinon fournie)
  coupleAgeGroup         String?
  coupleDisciplineLatin  Boolean             @default(false)
  coupleDisciplineStandard Boolean           @default(false)
  event                  Event               @relation(fields: [eventId], references: [id])
  user                   User                @relation(fields: [userId], references: [id])
  partnerUser            User?               @relation("RegistrationPartner", fields: [partnerUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([partnerUserId])
  @@index([status])
  @@index([checkedIn])
  @@index([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status]) // inscriptions actives par épreuve
  @@index([eventId, status, userId]) // inscriptions actives d'un user à une épreuve
}

model Result {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  round     String
  ranking   Int
  details   Json?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])

  @@index([userId, createdAt]) // résultats d'un user triés par date
  @@index([eventId])           // lookup résultats par épreuve (career-query)
}

model ScheduleItem {
  id            String      @id @default(uuid())
  competitionId String
  startTime     DateTime
  title         String
  type          String
  eventId       String?
  // Saisie de l'éditeur club (#442) : heure locale `HH:MM` telle que tapée
  // (`startTime` en est l'instant, jour de la compétition, Europe/Paris),
  // durée en minutes et rang dans le planning.
  startClock      String?
  durationMinutes Int?
  position        Int?
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id])
  event         Event?      @relation(fields: [eventId], references: [id])

  @@index([competitionId])            // lookup items par compétition
  @@index([competitionId, startTime]) // items triés par heure de début
  @@index([eventId])                  // lookup items liés à une épreuve
}

model SeatBooking {
  id            String          @id @default(uuid())
  competitionId String
  competition   Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  itemId        String          // ID within the layout JSON
  seatLabel     String?         // e.g. "Rang A, Place 5"
  status        BookingStatus   @default(PENDING)
  paymentId     String?         // External ID (HelloAsso)
  expectedAmountCents Int?      // Server-side price in cents, fixed at checkout (#381)
  expiresAt     DateTime?       // For temporary holds
  cancelReason  String?         // Why a seat was released, e.g. HELLOASSO_REFUNDED / HELLOASSO_CONTESTED (#403)
  // Seat within the layout element (#428): numbered seat (TABLE / GRADIN,
  // index = row * cols + col) or server-assigned place slot (free placement).
  // NULL only on bookings made before #428 (whole element).
  seatIndex     Int?
  // 0..3 while PENDING: at most 4 pending bookings per user and competition (#428)
  pendingSlot   Int?            @db.SmallInt
  // Earlier checkout intents of this booking, replaced when the payment was resumed (#428)
  supersededPaymentIds String[] @default([])
  checkoutRedirectUrl  String?  // HelloAsso redirect of `paymentId`, returned only to the booking owner (#428)
  checkoutCreatedAt    DateTime? // When `paymentId` was created (redirect valid 15 min)
  // Paid but no seat granted (late or duplicate payment): refund owed, one
  // entry per checkout intent to refund; `refundOwedAt` is set while the
  // list is not empty (#428, refunds made by hand by the club, #438).
  refundOwedPaymentIds String[] @default([])
  refundOwedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([competitionId])
  @@index([userId])
  @@index([competitionId, itemId, seatLabel])
  // One active booking per seat (#402, per seat since #428): a PENDING hold
  // or a CONFIRMED seat. EXPIRED/CANCELLED rows are history and never block
  // the seat. An expired PENDING hold is switched to EXPIRED before a new
  // checkout (#401). Free placement: one row per place slot, so the element's
  // capacity is enforced by the same index.
  @@unique([competitionId, itemId, seatIndex], map: "SeatBooking_active_seat_index_key", where: raw("((status = ANY (ARRAY['PENDING'::\"BookingStatus\", 'CONFIRMED'::\"BookingStatus\"])) AND (\"seatIndex\" IS NOT NULL))"))
  // Bookings without a seat index (before #428, or written by a rolled-back
  // revision) keep the former guarantee: one active booking per element.
  @@unique([competitionId, itemId], map: "SeatBooking_active_item_legacy_key", where: raw("((status = ANY (ARRAY['PENDING'::\"BookingStatus\", 'CONFIRMED'::\"BookingStatus\"])) AND (\"seatIndex\" IS NULL))"))
  // At most 4 PENDING bookings per user and competition (#428): each takes
  // one of the slots 0..3 (CHECK constraint in the migration).
  @@unique([competitionId, userId, pendingSlot], map: "SeatBooking_pending_cap_key", where: raw("(status = 'PENDING'::\"BookingStatus\")"))
}
