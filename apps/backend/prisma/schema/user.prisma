/// Niveaux du Passeport Danse (couleurs). Jaune/Orange = commun Latine+Standard ; à partir de Vert = par discipline.
enum PassportLevel {
  BLANC
  BEIGE
  JAUNE
  ORANGE
  VERT
  VIOLET
  BLEU
  ROUGE
  NOIR
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  // Lookup key of `email` (#526): normalizeEmail(email), written with every address write. NULL for legacy
  // case duplicates (never merged) and rows written by an older release (rollback); `email` stays the source of truth.
  emailNormalized      String?        @unique
  password             String
  firstName            String
  lastName             String
  role                 UserRole       @default(LICENSEE)
  extraRoles           UserRole[]     @default([]) // Rôles supplémentaires (multi-profil, lot 1c) ; jamais le rôle principal
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  lastLoginAt          DateTime?      // Dernière connexion réussie (back-office : « renvoyer l'invitation » tant que null)
  disabledAt           DateTime?      // Désactivé par un admin (null = actif) : connexion, refresh et requêtes refusés
  // Dernière version de la politique de confidentialité signalée et lue (#734) ; null = jamais. Information, pas consentement.
  privacyPolicySeenVersion String?
  isStoreReview        Boolean        @default(false) // Compte de validation App Store / Google Play : écritures simulées, ni supprimable ni désactivable
  ageGroup             String?        // 1 seule classe d'âge par licencié
  category             String?        // discipline(s) : Latin, Standard, Ten Dance
  clubId               String?
  clubName             String?        // Affichage / rétrocompatibilité ; préférer clubId pour le lien
  birthDate            DateTime?
  nationalRanking      Int?
  passportLevelLatin   PassportLevel? // Niveau Passeport Danse en Latine (à partir de Vert évalué séparément)
  passportLevelStandard PassportLevel? // Niveau Passeport Danse en Standard
  competitionLevel     String?        // DEPRECATED : niveau unique historique, repli en lecture (anciens clients, rollback) ; à supprimer plus tard
  competitionLevelLatin String?       // Niveau compétition en Latine : Débutant, Intermédiaire, Avancé, International (indépendant du Passeport Danse)
  competitionLevelStandard String?    // Niveau compétition en Standard (mêmes valeurs ; un danseur peut avoir deux niveaux différents)
  wdsfMin              String?        // Numéro MIN WDSF (Member Identification Number) si licence WDSF liée
  wdsfNationality      String?
  wdsfLicenseType     String?
  wdsfAgeGroup        String?
  wdsfExpiresOn       DateTime?
  wdsfFederation      String?        // Fédération nationale (member body) relue auprès de la WDSF à la liaison
  club                 Club?          @relation(fields: [clubId], references: [id], onDelete: SetNull)
  partnershipsAsUser1  Partnership[]  @relation("PartnershipUser1")
  partnershipsAsUser2  Partnership[]  @relation("PartnershipUser2")
  soloTeamMemberships  SoloTeamMember[]
  license              License?
  licenseRenewalRequests LicenseRenewalRequest[] @relation("LicenseRenewalRequester")
  licenseRenewalsReviewed LicenseRenewalRequest[] @relation("LicenseRenewalsReviewed")
  walletPassDownloadTokens WalletPassDownloadToken[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  deviceTokens         DeviceToken[]
  refreshTokens        RefreshToken[]
  registrations        Registration[]
  registrationsAsPartner Registration[] @relation("RegistrationPartner")
  passwordResetTokens  PasswordResetToken[]
  seatBookings         SeatBooking[]
  submittedTracks      Track[]        @relation("TrackSubmissions")
  trackCorrectionsProposed TrackCorrection[] @relation("TrackCorrectionsProposed")
  trackCorrectionsReviewed TrackCorrection[] @relation("TrackCorrectionsReviewed")
  adminAuditActions    AdminAuditLog[] @relation("AdminAuditActor")
  parentalConsents     ParentalConsent[]

  @@index([email])
  @@index([role])
  @@index([clubName])
  @@index([clubId])
  @@index([clubId, role]) // membres d'un club filtrés par rôle
  @@index([disabledAt])
  @@index([createdAt]) // back-office : liste triée par date d'inscription (défaut)
  @@index([lastName, firstName]) // back-office : tri par nom
}

enum UserRole {
  LICENSEE // Licencié — pratiquant avec licence FFD
  CLUB    // Structure (Club) — représentant du club
  STAFF   // Staff FFD — organisateur d'événement, scanner, etc.
  ADMIN   // Administration plateforme
}

/// Journal d'audit des accès support (« se connecter en tant que », #545,
/// réservés aux administrateurs depuis #733). Une ligne par session :
/// qui, cible, quand, pourquoi. Obligatoire pour la traçabilité RGPD (accès à
/// des données de tiers) ; chaque requête de la session relit sa ligne
/// (JwtStrategy) et la session meurt à l'arrêt, au plus tard 15 min après
/// `startedAt`.
model ImpersonationLog {
  id             String    @id @default(uuid())
  /// Auteur de l'accès support (administrateur uniquement).
  actorId        String
  /// Rôle qui a autorisé l'accès : toujours ADMIN depuis #733 (les lignes
  /// plus anciennes peuvent porter STAFF), pas le rôle principal.
  actorRole      UserRole
  /// Compte cible dont on prend l'identité (jamais un administrateur).
  targetUserId   String
  /// Rôle principal de la cible.
  targetRole     UserRole
  /// Motif, facultatif ; sans donnée personnelle de tiers.
  reason         String?
  /// IP de l'administrateur, réduite à son réseau au bout de 90 jours (#731).
  ip             String?
  startedAt      DateTime  @default(now())
  /// Renseigné à l'arrêt de la session par l'administrateur.
  endedAt        DateTime?

  @@index([actorId])
  @@index([targetUserId])
  @@index([startedAt])

  /// Écritures faites pendant la session (#761), supprimées avec elle.
  actions        ImpersonationActionLog[]
}

/// Journal des écritures faites pendant un accès support (#761) : une ligne
/// par requête non-GET (méthode, route sans identifiant ni paramètre, statut
/// HTTP). Jamais de corps, d'identifiant d'URL ni d'identité de l'intervenant
/// (portée par la session). Supprimée avec sa session (ON DELETE CASCADE), donc
/// à la même échéance (IMPERSONATION_LOG_RETENTION_DAYS).
model ImpersonationActionLog {
  id                 String           @id @default(uuid())
  impersonationLogId String
  session            ImpersonationLog @relation(fields: [impersonationLogId], references: [id], onDelete: Cascade)
  /// POST, PUT, PATCH ou DELETE.
  method             String
  /// Modèle de route, ex. « /competitions/:id/unregister ».
  route              String
  statusCode         Int
  at                 DateTime         @default(now())

  @@index([impersonationLogId, at]) // export RGPD : actions d'une session, dans l'ordre
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  // Index composite pour lookup token valide : WHERE userId = ? AND revoked = false
  @@index([userId, revoked])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([used])
}

model VolunteerToken {
  id            String      @id @default(uuid())
  /// SHA-256 hex of the volunteer link token (the plain token is never stored).
  token         String      @unique
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  name          String      @default("Bénévole")
  createdAt     DateTime    @default(now())

  @@index([token])
  @@index([competitionId])
}
