model License {
  id              String   @id @default(uuid())
  number          String   @unique
  validUntil      DateTime
  category        String
  clubName        String
  userId          String?  @unique
  qrCodeSignature String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id])

  @@index([number])
  @@index([userId])
}

/// Numéro de licence retiré par un changement de numéro (#448, #466).
/// Un QR qui ne lie que le numéro (v1 signé, ancien QR non signé) n'est plus
/// accepté pour un numéro présent ici : il a pu être réattribué à une autre
/// personne. Pas de clé étrangère : la ligne survit à la licence.
model RetiredLicenseNumber {
  number    String   @id
  /// Licence qui portait ce numéro (null si inconnue lors de la reprise).
  licenseId String?
  retiredAt DateTime @default(now())
}

/// Statut d'une demande de renouvellement de licence.
enum LicenseRenewalStatus {
  DRAFT    // Brouillon : documents en cours d'ajout
  PENDING  // Soumise : en attente de validation
  APPROVED // Validée : licence renouvelée
  REJECTED // Refusée
}

/// Type de document requis pour le renouvellement (OCR dédié par type).
enum LicenseRenewalDocumentType {
  MEDICAL_CERTIFICATE  // Certificat médical (apte à la pratique)
  LICENSE_CERTIFICATE  // Certificat / attestation de licence
}

model LicenseRenewalRequest {
  id        String                @id @default(uuid())
  userId    String
  status    LicenseRenewalStatus   @default(DRAFT)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation("LicenseRenewalRequester", fields: [userId], references: [id], onDelete: Cascade)
  documents LicenseRenewalDocument[]

  // ── Modération humaine (#19, #266) ─────────────────────────────────────
  // Colonnes NULLABLES : ajoutées à une table déjà peuplée, la migration reste
  // additive (ADR-0017). Voir ADR-0021.

  /// Passage DRAFT → PENDING. Ordre de la file de modération (plus anciennes
  /// d'abord). Rattrapé à `updatedAt` pour les demandes antérieures.
  submittedAt     DateTime?
  /// Administrateur qui a tranché : null tant que la demande n'est pas
  /// tranchée, pour une demande auto-approuvée avant #271, ou si son compte a
  /// été supprimé depuis.
  reviewedById    String?
  reviewedBy      User?     @relation("LicenseRenewalsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  /// Code de motif de refus (`RENEWAL_REJECTION_REASONS`), validé côté
  /// TypeScript : pas d'enum PostgreSQL, dont l'ajout de valeurs se migre mal.
  rejectionReason String?
  /// Commentaire libre de l'administrateur (≤ 500). Peut décrire le
  /// certificat : effacé par la purge de rétention avec le document (#62).
  reviewComment   String?

  @@index([userId])
  @@index([status])
  // File de modération : filtre par statut, tri par date de soumission.
  @@index([status, submittedAt])
  @@index([reviewedById])
}

model LicenseRenewalDocument {
  id         String                     @id @default(uuid())
  requestId  String
  type       LicenseRenewalDocumentType
  filePath   String
  ocrData    Json?                      // Résultat OCR (données extraites)
  /// Date à laquelle ce document DOIT avoir disparu (RGPD, #62).
  ///
  /// Calculée à l'écriture par `medicalCertificatePurgeDueAt`, et STOCKÉE plutôt
  /// que recalculée : l'échéance dépend de la date d'émission enfouie dans
  /// `ocrData`, que le SQL ne sait pas lire. Tant qu'elle n'était pas une
  /// colonne, la purge ramenait un lot « assez vieux » puis tranchait en
  /// mémoire — or l'échéance N'EST PAS MONOTONE en `createdAt` (un certificat
  /// daté vit 24 mois, un non daté 12), si bien que des documents non échus
  /// occupaient le lot devant des documents échus, jusqu'à ne plus rien purger
  /// du tout, en silence. Ici le filtre est exact.
  ///
  /// NULLABLE par nécessité : colonne ajoutée à une table déjà peuplée, la
  /// migration doit rester additive (ADR-0017). Les lignes antérieures sont
  /// datées au fil de l'eau par la purge elle-même.
  purgeDueAt DateTime?
  createdAt  DateTime                   @default(now())
  request   LicenseRenewalRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([type])
  // Sert les deux requêtes de la purge (#62) : les documents échus
  // (`purgeDueAt <= now`, triés par échéance) et ceux restant à dater
  // (`purgeDueAt IS NULL`). `@@index([type])` est conservé — le retirer serait
  // un DROP, et les migrations restent strictement additives (ADR-0017).
  @@index([type, purgeDueAt])
}

/// Jeton de téléchargement d'un pass Apple Wallet de la licence (#162).
///
/// L'app (authentifiée) obtient une URL contenant ce jeton puis l'ouvre dans
/// Safari, qui n'a pas le JWT : le jeton remplace l'authentification le temps
/// du téléchargement. Court (quelques minutes) et réutilisable dans cette
/// fenêtre, mais borné à quelques téléchargements : certains navigateurs iOS
/// (Firefox…) récupèrent l'URL plusieurs fois avant de la passer à Wallet.
/// Chaque téléchargement incrémente `downloadCount` par un UPDATE conditionnel
/// atomique (deux requêtes concurrentes ne peuvent pas dépasser le quota). Seul
/// le SHA-256 du jeton est stocké. Une seule ligne par utilisateur (`userId`
/// unique, émission par upsert) : un nouveau jeton remplace le précédent et
/// remet le compteur à zéro, même si deux demandes arrivent en même temps, sans
/// tâche planifiée (backend scale-to-zero).
model WalletPassDownloadToken {
  id            String   @id @default(uuid())
  /// SHA-256 hex du jeton (le jeton en clair n'est jamais stocké).
  tokenHash     String   @unique
  userId        String   @unique
  expiresAt     DateTime
  /// Téléchargements déjà servis avec ce jeton (remis à 0 à chaque émission).
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Journal des accès aux données de santé (RGPD art. 9 et 32, #63).
///
/// Une ligne par accès d'un TIERS (administrateur, impersonation), par export
/// ou par suppression d'un certificat médical ou d'une demande de
/// renouvellement : qui, en quelle qualité, quoi, quand, par quelle route.
/// JAMAIS le contenu (ni `ocrData`, ni commentaire, ni nom, ni e-mail) : on
/// trace l'accès, pas la donnée.
///
/// Aucune clé étrangère : la trace survit à la suppression du compte concerné
/// comme à celle de l'acteur (seuls des UUID restent). Rétention : 1 an, purgée
/// par `HealthDataRetentionService` (politique de confidentialité §5).
///
/// Colonnes texte validées côté TypeScript plutôt qu'enums PostgreSQL, dont
/// l'ajout de valeurs se migre mal (même choix que `rejectionReason`).
model HealthDataAccessLog {
  id            String   @id @default(uuid())
  /// Personne dont les données de santé sont concernées.
  subjectUserId String
  /// Auteur de l'accès ; null pour un traitement automatique (purge).
  actorUserId   String?
  /// Qualité de l'acteur : ADMIN, OWNER, IMPERSONATOR, SYSTEM.
  actorRole     String
  /// READ, DOWNLOAD, EXPORT, DELETE.
  action        String
  /// LICENSE_RENEWAL_REQUEST ou MEDICAL_CERTIFICATE (id du document).
  resourceType  String
  resourceId    String
  /// Route (gabarit, sans identifiant) ou traitement à l'origine de l'accès.
  route         String
  createdAt     DateTime @default(now())

  // « Qui a accédé aux données de santé de X ? »
  @@index([subjectUserId, createdAt])
  // « À quoi l'administrateur Y a-t-il accédé ? »
  @@index([actorUserId, createdAt])
  // Purge de rétention et tri du journal.
  @@index([createdAt])
}
