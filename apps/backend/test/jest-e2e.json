{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "maxWorkers": 1,
  "testTimeout": 60000,
  "globalSetup": "./setup/global-setup.ts",
  "globalTeardown": "./setup/global-teardown.ts",
  "moduleNameMapper": {
    "^newrelic$": "<rootDir>/setup/newrelic-mock.ts"
  }
}
