{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "if [ -d prisma/schema ]; then prisma generate --schema=./prisma/schema; else echo 'prisma/schema not present (docker manifest layer) — skipping generate'; fi",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:with-ip": "tsx scripts/update-ip.ts && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test": "jest --silent",
    "test:debug": "jest --verbose",
    "test:debug:inspect": "node --inspect-brk -r tsconfig-paths/register node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "test:integration": "npx dotenv-cli -e .env.test -- jest --config ./test/jest-integration.json --runInBand --forceExit",
    "test:integration:setup": "bash scripts/start-test-proxy.sh && sleep 2 && pnpm run test:integration",
    "proxy:test:start": "bash scripts/start-test-proxy.sh",
    "proxy:test:stop": "bash scripts/stop-test-proxy.sh",
    "migrate": "prisma migrate dev",
    "seed:e2e": "tsx prisma/seed-e2e.ts",
    "sync:compete": "tsx scripts/sync-licensees-from-compete.ts",
    "kill-port": "tsx scripts/kill-port.ts",
    "docs:export": "pnpm run build && node scripts/export-swagger.js",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run",
    "test:mutation:ci": "stryker run --reporters progress,html"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@ffd-connect/shared": "workspace:*",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^2.24.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nestjs": "^11.0.0",
    "@sentry/profiling-node": "^11.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.4",
    "firebase-admin": "^14.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^6.0.0",
    "multer": "^2.3.0",
    "music-tempo": "^1.0.3",
    "nestjs-pino": "^5.2.1",
    "opossum": "^10.0.0",
    "passkit-generator": "3.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.30.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "wav-decoder": "^1.3.0"
  },
  "devDependencies": {
    "@ffd-connect/jest-config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest-mock-extended": "^4.0.1",
    "nock": "^14.0.17",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.1",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
