# ============================================
# FFD CONNECT - Staging Environment
# ============================================
# cp .env.staging.example .env.staging
# All values must differ from production!
# ============================================

# Database (separate from production)
DATABASE_URL="postgresql://ffd:ffdpassword@db:5432/ffd_connect_staging"

# Auth (different secret than production!)
JWT_SECRET="staging-secret-key-min-32-chars-change-this!!"

# Server
PORT=3000
NODE_ENV=production

# CORS — staging domains only
CORS_ORIGINS=https://staging.ffd-connect.fr

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# External APIs — use sandbox/test endpoints when available
FFD_API_BASE_URL="https://api.ffdanse.fr"
FFD_API_PATH="/federal_actions"

# WDSF — use sandbox for staging
# WDSF_API_V1_URL="https://sandbox.worlddancesport.org/api/1"

# Email — use test sender
RESEND_API_KEY="re_your_staging_api_key"
RESEND_FROM_EMAIL="staging@ffd-connect.fr"

# Sentry — separate project or same with environment tag
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
