# ============================================
# FFD CONNECT - Production Environment
# ============================================
# Use a secrets manager (AWS Secrets Manager, Vault, etc.)
# for production values. This file is a reference only.
# ============================================

# Database (managed PostgreSQL recommended: RDS, Supabase, Neon)
DATABASE_URL="postgresql://user:password@your-managed-db:5432/ffd_connect_prod"

# Auth (strong secret, rotated periodically)
# Generate: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_STRONG_SECRET"

# Server
PORT=3000
NODE_ENV=production

# CORS — production domains only
CORS_ORIGINS=https://app.ffd-connect.fr,https://ffd-connect.fr

# Redis (managed Redis recommended: ElastiCache, Upstash)
REDIS_HOST=your-managed-redis
REDIS_PORT=6379
# REDIS_PASSWORD="your-redis-password"

# External APIs
FFD_API_BASE_URL="https://api.ffdanse.fr"
FFD_API_PATH="/federal_actions"

# WDSF
# WDSF_API_KEY="your-production-wdsf-token"
# WDSF_USERNAME="your-production-username"
# WDSF_PASSWORD="your-production-password"

# Email
RESEND_API_KEY="re_your_production_api_key"
RESEND_FROM_EMAIL="noreply@ffd-connect.fr"

# Firebase (push notifications)
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_PRIVATE_KEY="your-private-key"
# FIREBASE_CLIENT_EMAIL="your-client-email"

# Sentry
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# GitHub (bug reports)
# GITHUB_TOKEN="your-github-token"
# GITHUB_OWNER="GabinSMD"
# GITHUB_REPO="ffd-connect-reports"
