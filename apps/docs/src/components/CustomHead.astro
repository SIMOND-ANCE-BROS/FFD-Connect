---
// Composant Head personnalisé pour activer les View Transitions + police FFD
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { ClientRouter } from "astro:transitions";
---

<DefaultHead />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
<ClientRouter />
<style is:global>
  /* Masque le header Starlight par défaut si présent */
  header:not(.custom-header) {
    display: none !important;
  }
  
  /* S'assure que le header personnalisé est visible */
  .custom-header {
    display: block !important;
  }
</style>
