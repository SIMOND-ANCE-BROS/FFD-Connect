---
interface Props {
  profiles: string[];
}

const { profiles } = Astro.props;

const colorMap: Record<string, { bg: string; text: string; border: string }> = {
  Membre: { bg: "#dbeafe", text: "#1d4ed8", border: "#93c5fd" },
  Staff: { bg: "#ffedd5", text: "#c2410c", border: "#fdba74" },
  "Responsable de club": { bg: "#f3e8ff", text: "#7e22ce", border: "#d8b4fe" },
  Admin: { bg: "#fee2e2", text: "#b91c1c", border: "#fca5a5" },
};
---

<div class="profile-badge-container">
  <span class="profile-badge-label">👤 Profil concerné :</span>
  {
    profiles.map((profile) => {
      const colors = colorMap[profile] ?? {
        bg: "#f3f4f6",
        text: "#374151",
        border: "#d1d5db",
      };
      return (
        <span
          class="profile-badge"
          style={`background:${colors.bg}; color:${colors.text}; border-color:${colors.border};`}
        >
          {profile}
        </span>
      );
    })
  }
</div>

<style>
  .profile-badge-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1.5rem;
    padding: 12px 16px;
    background: var(--sl-color-bg-sidebar);
    border-radius: 8px;
    border: 1px solid var(--sl-color-gray-5);
  }

  .profile-badge-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: 4px;
  }

  .profile-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid;
  }
</style>
