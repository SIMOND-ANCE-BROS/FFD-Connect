---
// Composant Header personnalisé inspiré de HelloAsso
// Remplace le header Starlight par défaut avec une navigation personnalisée
// Le header persiste entre les pages grâce à transition:persist
---

<header class="custom-header" transition:persist="header">
  <div class="header-container">
    <div class="header-logo">
      <a href="/" class="logo-link" data-astro-prefetch>
        <span class="logo-text">FFD-Connect</span>
        <span class="logo-badge">Docs</span>
      </a>
    </div>
    
    <nav class="header-nav">
      <a href="/" class="nav-link" data-astro-prefetch>Home</a>
      <a href="/guide/introduction/" class="nav-link" data-astro-prefetch>Documentation</a>
      <a href="/api-docs/" class="nav-link" data-astro-prefetch>API Reference</a>
      <a href="/changelog/" class="nav-link" data-astro-prefetch>Changelog</a>
    </nav>

    <div class="header-actions">
      <a href="https://github.com/GabinSMD/FFD-Connect" class="header-btn secondary" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</header>

<style>
  .custom-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(var(--sl-color-bg-rgb), 0.95);
    border-bottom: 1px solid var(--sl-color-hairline);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    /* S'assure que le header reste au-dessus de tout */
    isolation: isolate;
  }

  /* Cache le header Starlight par défaut si présent */
  :global(header:not(.custom-header)) {
    display: none !important;
  }

  .header-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 2rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--sl-color-text);
    font-weight: 700;
    font-size: 1.25rem;
    transition: opacity 0.2s;
  }

  .logo-link:hover {
    opacity: 0.8;
  }

  .logo-text {
    color: var(--sl-color-text);
  }

  .logo-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.5rem 0;
    position: relative;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--sl-color-text);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--sl-color-accent);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  .nav-link[aria-current="page"] {
    color: var(--sl-color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-btn {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-btn.secondary {
    background: transparent;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
  }

  .header-btn.secondary:hover {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-5);
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 0 1rem;
      height: 56px;
    }

    .header-nav {
      display: none;
    }

    .logo-text {
      font-size: 1.1rem;
    }

    .logo-badge {
      font-size: 0.7rem;
      padding: 0.2rem 0.4rem;
    }
  }
</style>
