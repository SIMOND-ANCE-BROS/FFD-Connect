{
  "java.compile.nullAnalysis.mode": "automatic",
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.cp/**",
    "**/.project",
    "**/.settings/**",
    "**/.factorypath",
    "**/.git/**",
    "**/.vs/**"
  ],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "eslint.workingDirectories": ["./apps/client", "./apps/backend", "./apps/landing"],

  // --- Performance Optimizations ---
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/dist/**": true,
    "**/android/app/build/**": true,
    "**/ios/Pods/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/ios/Pods": true,
    "**/android/app/build": true,
    "**/dist": true,
    "**/.next": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/ios/Pods": true,
    "**/android/app/build": true,
    "**/dist": true
  },

  // --- TypeScript & DX ---
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // --- File Nesting (Clean Explorer) ---
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": ".npmrc, .npmignore, .prettierrc, .eslintrc.js, .eslintrc.json, tsconfig.json, tsconfig.*.json, package-lock.json, pnpm-lock.yaml, yarn.lock, bun.lockb",
    "*.ts": "${capture}.js, ${capture}.d.ts.map, ${capture}.*.ts, ${capture}_*.js, ${capture}_*.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    ".env": ".env.*",
    "docker-compose.yml": "docker-compose.*.yml, .dockerignore, Dockerfile"
  },

  // --- Jest Extension ---
  // Run profile (bouton ▶) : silencieux comme `pnpm test`
  "jest.jestCommandLine": "jest --silent",
  // Debug profile (bouton 🐛) : configuré dans launch.json avec --verbose

  // --- Terminal ---
  "terminal.integrated.defaultProfile.osx": "zsh",
  "debug.allowBreakpointsEverywhere": true
}
