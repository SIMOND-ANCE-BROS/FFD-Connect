# Other apps - not needed for client build.
#
# apps/backend is excluded DIRECTORY BY DIRECTORY so that its top-level files
# stay in the archive — swagger.json above all. The client's postinstall
# generates src/api/generated/ from that spec, and without it Metro fails with
# "Unable to resolve module ../../../api/generated". Before #51 the generated
# files were committed and travelled here; they no longer do, which is what
# broke builds 83 and 16.
#
# Do NOT collapse this to `apps/backend/`, and do not try `apps/backend/*` with
# a `!apps/backend/swagger.json` negation: measured with
# `eas build:inspect --stage archive`, EAS does not implement gitignore
# semantics — `/*` excludes files but not subdirectories, and the negation is
# ignored outright.
apps/backend/src/
apps/backend/test/
apps/backend/prisma/
apps/backend/docs/
apps/backend/scripts/
apps/backend/dist/
apps/backend/coverage/
# Its manifest must stay out too: present, pnpm treats the backend as a
# workspace member and runs its postinstall, which is `prisma generate` — and
# the schema lives in the excluded prisma/ directory. Measured: the install
# dies on "You don't have any datasource defined in your schema.prisma".
# Everything else here is inert, but shipping it is pointless.
apps/backend/package.json
apps/backend/Dockerfile
apps/backend/docker-entrypoint.sh
apps/backend/prisma.config.ts
apps/backend/nest-cli.json
apps/backend/tsconfig*.json
apps/backend/jest.*.js
apps/backend/eslint.config.js
apps/backend/stryker.config.js
apps/backend/README.md
apps/landing/
apps/docs/

# Native folders - EAS rebuilds them
apps/client/ios/
apps/client/android/

# Large uploads
apps/backend/uploads/

# Cache and artifacts
**/.expo/
**/.expo-shared/
**/node_modules/
**/coverage/
**/.jest-cache/
**/*.log

# Dev/CI files
docs/
scripts/
.github/
.husky/
.changeset/

# Dev artifacts in apps/client (logs, coverage, lint results)
apps/client/coverage/
apps/client/coverage-report.json
apps/client/coverage_*.txt
apps/client/lint-results*.json
apps/client/test_results*.log
apps/client/tsc_errors*.log
apps/client/vendor/
apps/client/docs/
apps/client/public/

# Misc
.DS_Store
**/.DS_Store
*.sql
backups/
.env
.env.*
!.env.example
**/__tests__/**/*.mp3
**/__tests__/**/*.png
**/__mocks__/**/*.mp3
